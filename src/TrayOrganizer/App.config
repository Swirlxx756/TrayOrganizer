<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0"/>
  </startup>
  <runtime>
    <!-- Let WPF re-scale the UI when a window moves between monitors with different DPI (Per-Monitor V2). -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false"/>
  </runtime>
</configuration>
