<Window x:Class="TrayOrganizer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="托盘收纳"
        Width="1000" Height="680"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowFallback}"
        Foreground="{DynamicResource TextPrimary}"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Left navigation pane ===================== -->
        <Grid Grid.Column="0" Margin="12,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,4,0,12">
                <TextBox x:Name="SearchBox"
                         Tag="搜索图标"
                         Padding="10,5,34,5"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock Style="{StaticResource Glyph}"
                           Text="&#xE721;"
                           FontSize="14"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           IsHitTestVisible="False"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <RadioButton x:Name="NavAll" Style="{StaticResource NavItem}" GroupName="Nav" Tag="ALL" Click="NavItem_Click" Margin="0,0,0,2" IsChecked="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="全部图标" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavAllCount" Grid.Column="2" Foreground="{DynamicResource TextTertiary}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavOrganized" Style="{StaticResource NavItem}" GroupName="Nav" Tag="ORGANIZED" Click="NavItem_Click" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7B8;" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="已收纳" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavOrganizedCount" Grid.Column="2" Foreground="{DynamicResource TextTertiary}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavUngrouped" Style="{StaticResource NavItem}" GroupName="Nav" Tag="UNGROUPED" Click="NavItem_Click" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="未分组" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavUngroupedCount" Grid.Column="2" Foreground="{DynamicResource TextTertiary}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </RadioButton>

                    <Grid Margin="12,16,0,4">
                        <TextBlock Text="文件夹" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                        <Button x:Name="NewFolderBtn"
                                Style="{StaticResource SubtleButton}"
                                HorizontalAlignment="Right"
                                Width="28" Height="28" MinHeight="28" Padding="0"
                                ToolTip="新建文件夹"
                                Click="NewFolderBtn_Click">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="FoldersPanel"/>
                </StackPanel>
            </ScrollViewer>

            <RadioButton x:Name="NavSettings" Grid.Row="2" Style="{StaticResource NavItem}" GroupName="Nav" Tag="SETTINGS" Click="NavItem_Click" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="设置" VerticalAlignment="Center"/>
                </Grid>
            </RadioButton>
        </Grid>

        <!-- ===================== Content area ===================== -->
        <Border Grid.Column="1"
                Background="{DynamicResource LayerFill}"
                BorderBrush="{DynamicResource LayerStroke}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
            <Grid>
                <!-- Icons page -->
                <Grid x:Name="IconsPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="32,24,32,0">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource TitleText}" Text="全部图标" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PageStats" Style="{StaticResource CaptionText}" Margin="1,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="32,16,32,0">
                        <!-- Accent InfoBar: external drag in progress -->
                        <Border x:Name="DragBanner"
                                Visibility="Collapsed"
                                Background="{DynamicResource AccentSubtle}"
                                BorderBrush="{DynamicResource CardStroke}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16,12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DragBannerText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Caution InfoBar: paused -->
                        <Border x:Name="PausedBanner"
                                Visibility="Collapsed"
                                Background="{DynamicResource CautionFill}"
                                BorderBrush="{DynamicResource CardStroke}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16,8,8,8"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource CautionText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="收纳已暂停，图标已恢复到系统托盘" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="继续" Margin="12,0,0,0" VerticalAlignment="Center" Click="ResumeBtn_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Command row -->
                    <Grid Grid.Row="2" Margin="32,8,32,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="SelectAllCheck"
                                      IsThreeState="True"
                                      MinWidth="0"
                                      Margin="13,0,8,0"
                                      VerticalAlignment="Center"
                                      ToolTip="全选 / 取消全选"
                                      Click="SelectAllCheck_Click"/>
                            <TextBlock x:Name="SelectionText" Text="已选 0 项" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BindToBtn" Style="{StaticResource AccentButton}" Click="BindToBtn_Click" Margin="0,0,8,0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="收纳到" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="UnbindBtn" Content="移出收纳" Click="UnbindBtn_Click" Margin="0,0,8,0" IsEnabled="False"/>
                            <Button x:Name="RefreshBtn" Style="{StaticResource SubtleButton}" Width="32" Height="32" Padding="0" ToolTip="刷新" Click="RefreshBtn_Click" Margin="0,0,2,0">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;"/>
                            </Button>
                            <Button x:Name="FlyoutBtn" Style="{StaticResource SubtleButton}" Width="32" Height="32" Padding="0" ToolTip="打开收纳面板" Click="FlyoutBtn_Click">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Icon list -->
                    <Grid Grid.Row="3">
                        <ScrollViewer x:Name="IconsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="IconsListPanel" Margin="32,0,32,24"/>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyState"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="32,0,32,64">
                            <TextBlock x:Name="EmptyGlyph" Style="{StaticResource Glyph}" Text="&#xE7B8;" FontSize="48" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyTitle" Style="{StaticResource BodyStrong}" Text="这里还没有图标" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock x:Name="EmptyHint" Style="{StaticResource CaptionText}" Text="" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Settings page -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,24,32,32">
                        <TextBlock Style="{StaticResource TitleText}" Text="设置"/>

                        <!-- Behavior -->
                        <TextBlock Style="{StaticResource BodyStrong}" Text="收纳行为" Margin="1,24,0,8"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="原位处理方式"/>
                                <TextBlock Style="{StaticResource CaptionText}" Text="图标被收纳后，它在系统托盘中的原位置如何处理" Margin="0,2,0,8"/>
                                <RadioButton x:Name="HideCompleteRadio" GroupName="HideStrategy" Content="完全隐藏原图标" Click="HideStrategyRadio_Click" Margin="0,0,0,2"/>
                                <RadioButton x:Name="HideDemoteRadio" GroupName="HideStrategy" Content="仅移到 ^ 隐藏图标面板" Click="HideStrategyRadio_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="暂停收纳"/>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="暂停后，所有已收纳的图标会临时恢复到系统托盘" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="PauseToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0" VerticalAlignment="Center" Click="PauseToggle_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="拖入时自动打开收纳面板"/>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="从系统托盘拖动图标时，自动在托盘附近弹出收纳面板" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoOpenToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0" VerticalAlignment="Center" Click="AutoOpenToggle_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="浮层动画"/>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="收纳面板展开文件夹、返回和关闭时的过渡动画；关闭后全部瞬时切换" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="FlyoutAnimToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0" VerticalAlignment="Center" Click="FlyoutAnimToggle_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="显示文件夹名称"/>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="在收纳面板的文件夹图标下方显示名称；关闭后只在鼠标悬停时提示" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ShowFolderNamesToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0" VerticalAlignment="Center" Click="ShowFolderNamesToggle_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="浮层布局"/>
                                <TextBlock Style="{StaticResource CaptionText}" Text="文件夹：按文件夹分组，点击进入；平铺：像系统 ^ 面板一样直接列出所有运行中的已收纳图标" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <RadioButton x:Name="LayoutFolderRadio" GroupName="FlyoutLayout" Content="文件夹" Tag="0" Click="LayoutRadio_Click" Margin="0,0,0,2"/>
                                <RadioButton x:Name="LayoutFlatRadio" GroupName="FlyoutLayout" Content="平铺" Tag="1" Click="LayoutRadio_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="文件夹大小"/>
                                <TextBlock Style="{StaticResource CaptionText}" Text="小：点击打开文件夹；大：像 iOS 大文件夹，直接显示并可点击其中的图标（仅文件夹布局）" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <RadioButton x:Name="FolderSizeSmallRadio" GroupName="FolderSize" Content="小" Tag="0" Click="FolderSizeRadio_Click" Margin="0,0,0,2"/>
                                <RadioButton x:Name="FolderSizeLargeRadio" GroupName="FolderSize" Content="大" Tag="1" Click="FolderSizeRadio_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- System -->
                        <TextBlock Style="{StaticResource BodyStrong}" Text="系统" Margin="1,24,0,8"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="主题"/>
                                <TextBlock Style="{StaticResource CaptionText}" Text="选择应用与收纳面板的外观；跟随系统时随 Windows 的深浅色切换" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <RadioButton x:Name="ThemeSystemRadio" GroupName="ThemeMode" Content="跟随系统" Tag="0" Click="ThemeRadio_Click" Margin="0,0,0,2"/>
                                <RadioButton x:Name="ThemeLightRadio" GroupName="ThemeMode" Content="浅色" Tag="1" Click="ThemeRadio_Click" Margin="0,0,0,2"/>
                                <RadioButton x:Name="ThemeDarkRadio" GroupName="ThemeMode" Content="深色" Tag="2" Click="ThemeRadio_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="开机自动启动"/>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="登录 Windows 后在后台启动，并自动收起已收纳的图标" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0" VerticalAlignment="Center" Click="StartupToggle_Click"/>
                            </Grid>
                        </Border>

                        <!-- Actions -->
                        <TextBlock Style="{StaticResource BodyStrong}" Text="快捷操作" Margin="1,24,0,8"/>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="配置文件目录"/>
                                    <TextBlock x:Name="ConfigDirText" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开" Margin="16,0,0,0" VerticalAlignment="Center" Click="OpenConfigDirBtn_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="恢复全部图标并退出"/>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="把所有被收纳的图标放回系统托盘，然后退出托盘收纳" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="恢复并退出" Margin="16,0,0,0" VerticalAlignment="Center" Click="ExitAndRestoreBtn_Click"/>
                            </Grid>
                        </Border>

                        <!-- Log -->
                        <TextBlock Style="{StaticResource BodyStrong}" Text="运行日志" Margin="1,24,0,8"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CaptionText}" Text="最近的操作与自动识别记录" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="复制" Click="CopyLogBtn_Click"/>
                                </Grid>
                                <TextBox x:Name="LogTextBox"
                                         Height="220"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===================== ContentDialog overlay ===================== -->
        <Grid x:Name="DialogLayer"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="{DynamicResource SmokeFill}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              PreviewKeyDown="DialogLayer_PreviewKeyDown"
              MouseLeftButtonDown="DialogLayer_MouseLeftButtonDown">
            <Border x:Name="DialogCard"
                    MinWidth="340" MaxWidth="440"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Background="{DynamicResource FlyoutFill}"
                    BorderBrush="{DynamicResource SurfaceStroke}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.28" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="24,24,24,24">
                        <TextBlock x:Name="DialogTitle" Style="{StaticResource SubtitleText}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DialogBody" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="DialogInput" Margin="0,16,0,0" Visibility="Collapsed" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Row="1"
                            Background="{DynamicResource FlyoutFooterFill}"
                            CornerRadius="0,0,7,7"
                            Padding="24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DialogPrimary" Style="{StaticResource AccentButton}" Click="DialogPrimary_Click" IsDefault="False"/>
                            <Button x:Name="DialogCancel" Grid.Column="2" Content="取消" Click="DialogCancel_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
