<Window x:Class="TrayOrganizer.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="托盘收纳面板"
        SizeToContent="WidthAndHeight"
        MaxHeight="520"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Background="{DynamicResource FlyoutFallback}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Mirrors the Windows 11 ^ overflow panel: acrylic from DWM, 40x40 tiles, no extra chrome. Folder names optional (ShowFolderNames). -->
    <Grid x:Name="ContentRoot"
          Background="Transparent"
          RenderTransformOrigin="0,0"
          MouseEnter="ContentRoot_MouseEnter"
          MouseLeave="ContentRoot_MouseLeave"
          MouseRightButtonUp="ContentRoot_MouseRightButtonUp">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ContentTranslate" X="0" Y="0"/>
        </Grid.RenderTransform>

        <ScrollViewer x:Name="ContentScroll"
                      MaxHeight="380"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="TilesWrapPanel"
                       Orientation="Horizontal"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="5"/>
        </ScrollViewer>

        <Border x:Name="DropOutline"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                CornerRadius="4"
                BorderThickness="1"
                Background="{DynamicResource AccentSubtle}"
                BorderBrush="{DynamicResource AccentFill}"/>
    </Grid>
</Window>
