<Window x:Class="TrayOrganizer.UI.DragOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DragOverlay"
        Width="300" Height="88"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="12,8,12,16">
        <!-- shadow lives on a sibling so the content text stays crisp -->
        <Border CornerRadius="8" Background="{DynamicResource FlyoutFill}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.3" Color="Black"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="8"
                Background="{DynamicResource FlyoutFill}"
                BorderBrush="{DynamicResource SurfaceStroke}"
                BorderThickness="1"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4"
                        Background="{DynamicResource ControlAltFill}"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image x:Name="IconImg" Width="20" Height="20" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText" Text="正在拖入托盘图标"
                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" Text="拖入收纳文件夹完成绑定"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
